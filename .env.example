# Local development database. For production, switch to PostgreSQL as documented.
DATABASE_URL="file:./dev.db"

# Public site URL used for metadata and canonical generation.
NEXT_PUBLIC_SITE_URL="http://127.0.0.1:3000"

# Required for administrator authentication. Leave blank in this template.
# `npm run local:setup` generates strong per-checkout values in the ignored .env file.
AUTH_SECRET=""
CMS_ADMIN_EMAIL=""
CMS_ADMIN_PASSWORD=""

# Optional local upload override. Defaults to public/uploads when omitted.
UPLOADS_DIR=""